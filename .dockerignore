# Allowlist: the Docker build must not receive repository history, credentials,
# dependencies, browser traces, screenshots or unrelated local files.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!vite.config.js
!src/
!src/**
!public/
!public/audio/
!public/audio/entitiiii.mp3
!public/audio/README.md
!nginx/
!nginx/default.conf.template

# Keep secrets excluded even if someone adds them under an allowed directory.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
